<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://sitemaps.org">
    {% for sitemap in sitemaps %}
      <url>
        <loc>{{sitemap.url}}</loc>
        <lastmod>{{sitemap.last-mod}}</lastmod>
        <changefreq>{{sitemap.changefreq}}</changefreq>
        <priority>{{sitemap.priority}}</priority>
      </url>
    {% endfor %}
</urlset>